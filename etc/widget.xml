  PATTERN: Widget — etc/widget.xml + Block implementing Magento\Widget\Block\BlockInterface. Conditions type is the visual product picker.
  -->
<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">
    <widget id="null_blueprint_campaign_products"
            class="Null\Blueprint\Block\Widget\CampaignProducts"
            placeholder_image="Null_Blueprint::images/widget-campaign.png">
        <label translate="true">Blueprint Campaign Products</label>
        <description>Product list from a Campaign or from custom Magento conditions.</description>
        <parameters>
            <parameter name="mode" xsi:type="select" visible="true" required="true" sort_order="10"
                       source_model="Null\Blueprint\Model\Config\Source\WidgetMode">
                <label translate="true">Mode</label>
                <value>campaign</value>
            </parameter>
            <parameter name="campaign_id" xsi:type="select" visible="true" sort_order="20"
                       source_model="Null\Blueprint\Model\Config\Source\CampaignList">
                <label translate="true">Campaign</label>
                <depends>
                    <parameter name="mode" value="campaign"/>
                </depends>
            </parameter>
            <parameter name="title" xsi:type="text" required="false" visible="true" sort_order="30">
                <label translate="true">Title</label>
                <description translate="true">Leave empty to use the campaign title.</description>
            </parameter>
            <parameter name="condition" xsi:type="conditions" visible="true" required="false" sort_order="40"
                       class="Magento\CatalogWidget\Block\Product\Widget\Conditions">
                <label translate="true">Conditions</label>
                <depends>
                    <parameter name="mode" value="custom"/>
                </depends>
            </parameter>
            <parameter name="collection_sort_by" xsi:type="select" visible="true" sort_order="50"
                       source_model="Null\Blueprint\Model\Config\Source\SortBy">
                <label translate="true">Sort Collection By</label>
                <depends>
                    <parameter name="mode" value="custom"/>
                </depends>
            </parameter>
            <parameter name="collection_sort_order" xsi:type="select" visible="true" sort_order="60"
                       source_model="Null\Blueprint\Model\Config\Source\SortOrder">
                <label translate="true">Sort Collection Order</label>
                <depends>
                    <parameter name="mode" value="custom"/>
                </depends>
            </parameter>
            <parameter name="products_count" xsi:type="text" required="true" visible="true" sort_order="70">
                <label translate="true">Number of Products to Display</label>
                <value>10</value>
            </parameter>
            <parameter name="show_pager" xsi:type="select" visible="true" sort_order="80"
                       source_model="Magento\Config\Model\Config\Source\Yesno">
                <label translate="true">Display Page Control</label>
            </parameter>
            <parameter name="products_per_page" xsi:type="text" required="true" visible="true" sort_order="90">
                <label translate="true">Number of Products per Page</label>
                <depends>
                    <parameter name="show_pager" value="1"/>
                </depends>
                <value>5</value>
            </parameter>
            <parameter name="template" xsi:type="select" required="true" visible="true" sort_order="100">
                <label translate="true">Template</label>
                <options>
                    <option name="grid" value="Null_Blueprint::widget/campaign/grid.phtml" selected="true">
                        <label translate="true">Products Grid</label>
                    </option>
                    <option name="highlight" value="Null_Blueprint::widget/campaign/highlight.phtml">
                        <label translate="true">Highlight</label>
                    </option>
                </options>
            </parameter>
            <parameter name="cache_lifetime" xsi:type="text" visible="true" sort_order="110">
                <label translate="true">Cache Lifetime (Seconds)</label>
                <description translate="true">86400 by default. Clear Blocks HTML Output to refresh immediately.</description>
            </parameter>
        </parameters>
        <containers>
            <container name="content">
                <template name="grid" value="grid"/>
                <template name="highlight" value="highlight"/>
            </container>
            <container name="content.top">
                <template name="grid" value="grid"/>
                <template name="highlight" value="highlight"/>
            </container>
            <container name="content.bottom">
                <template name="grid" value="grid"/>
                <template name="highlight" value="highlight"/>
            </container>
        </containers>
    </widget>
</widgets>
