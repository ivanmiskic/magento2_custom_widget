  PATTERN: ACL — declare a view resource plus save/delete/config children. Controllers reference these constants.
  -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::marketing" title="Marketing" sortOrder="30">
                    <resource id="Null_Blueprint::campaign" title="Blueprint Campaigns" sortOrder="80">
                        <resource id="Null_Blueprint::campaign_save" title="Save" sortOrder="10"/>
                        <resource id="Null_Blueprint::campaign_delete" title="Delete" sortOrder="20"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Null_Blueprint::config" title="Null Blueprint" sortOrder="80"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
