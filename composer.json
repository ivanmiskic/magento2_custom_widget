{
    "name": "null/module-blueprint",
    "description": "Agentic Magento Open Source 2.4.8 module template. Campaigns drive admin CRUD, a catalog widget, storefront pages, REST, cron, CLI, and copyable Magento patterns.",
    "type": "magento2-module",
    "homepage": "https://github.com/ivanmiskic/magento2-agentic-blueprint",
    "license": "OSL-3.0",
    "keywords": [
        "magento2",
        "magento",
        "agentic",
        "module-template",
        "blueprint"
    ],
    "authors": [
        {
            "name": "Ivan Miskic",
            "homepage": "https://github.com/ivanmiskic"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0",
        "magento/framework": "^103.0.8",
        "magento/module-backend": "^102.0.8",
        "magento/module-catalog": "^104.0.8",
        "magento/module-catalog-widget": "^100.4.8",
        "magento/module-cms": "^104.0.8",
        "magento/module-config": "^101.2.8",
        "magento/module-store": "^101.1.8",
        "magento/module-ui": "^101.2.8",
        "magento/module-widget": "^101.2.8"
    },
    "require-dev": {
        "magento/magento-coding-standard": "^33.0",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Null\\Blueprint\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Null\\Blueprint\\Test\\": "Test/"
        }
    },
    "conflict": {
        "inchoo/module-catalog-widget": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "magento/magento-composer-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
