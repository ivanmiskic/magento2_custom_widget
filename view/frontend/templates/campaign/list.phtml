declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Null\Blueprint\ViewModel\CampaignList $viewModel */
$viewModel = $block->getData('view_model');
?>
<div class="blueprint-campaigns">
    <?php if ($viewModel->isEmpty()): ?>
        <?= /* @noEscape */ $block->fetchView($block->getTemplateFile('Null_Blueprint::campaign/list/empty.phtml')) ?>
    <?php else: ?>
        <ul class="blueprint-campaigns__list">
            <?php foreach ($viewModel->getItems() as $campaign): ?>
                <li class="blueprint-campaigns__item">
                    <a class="blueprint-campaigns__link"
                       href="<?= $escaper->escapeUrl($viewModel->getViewUrl($campaign)) ?>">
                        <?php $imageUrl = $viewModel->getImageUrl($campaign); ?>
                        <?php if ($imageUrl): ?>
                            <img class="blueprint-campaigns__image"
                                 src="<?= $escaper->escapeUrl($imageUrl) ?>"
                                 alt="<?= $escaper->escapeHtmlAttr($campaign->getTitle()) ?>"/>
                        <?php endif; ?>
                        <span class="blueprint-campaigns__title">
                            <?= $escaper->escapeHtml($campaign->getTitle()) ?>
                        </span>
                    </a>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>
</div>
