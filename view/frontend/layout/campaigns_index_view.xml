<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="null.blueprint.campaign.view"
                   template="Null_Blueprint::campaign/view.phtml"
                   cacheable="true">
                <arguments>
                    <argument name="view_model" xsi:type="object">Null\Blueprint\ViewModel\CampaignView</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
