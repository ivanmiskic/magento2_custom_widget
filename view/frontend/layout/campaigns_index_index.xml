<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument name="title" xsi:type="string" translate="true">Campaigns</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="null.blueprint.campaign.list"
                   template="Null_Blueprint::campaign/list.phtml"
                   cacheable="true">
                <arguments>
                    <argument name="view_model" xsi:type="object">Null\Blueprint\ViewModel\CampaignList</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
