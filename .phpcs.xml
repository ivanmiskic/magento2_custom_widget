<?xml version="1.0"?>
<ruleset name="Null Blueprint">
    <description>Magento Coding Standard for Null_Blueprint</description>
    <rule ref="Magento2">
        <!-- Vendor is Null (project standard). PHPCompatibility treats it as the null keyword. -->
        <exclude name="Magento2.NamingConvention.ReservedWords"/>
    </rule>
    <file>.</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/dev/qa/*</exclude-pattern>
    <exclude-pattern>*/Test/*</exclude-pattern>
    <exclude-pattern>*/docs/*</exclude-pattern>
    <exclude-pattern>*.less</exclude-pattern>
    <arg name="extensions" value="php,phtml"/>
    <ini name="ignore_warnings_on_exit" value="1"/>
</ruleset>
